# Ignore everything
*

# Un-ignore .gitignore itself
!.gitignore

# Un-ignore .htaccess (cPanel routing)
!.htaccess

# Un-ignore root-level build output files (copied by deploy.ps1)
!index.html
!asset-manifest.json
!manifest.json
!robots.txt
!favicon.ico
!logo.jpeg
!logo192.png
!logo512.png
!paynow-qr.jpeg

# Un-ignore static folder (CSS/JS)
!static/
!static/**

# Ignore build source folder (we copy from it, don't push it)
build/

# Ignore everything else
node_modules/
src/
public/
.env
.env.local
.env.development
.env.development.local
.env.test.local
