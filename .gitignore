# ==========================================
# IGNORE EVERYTHING FIRST
# ==========================================
*

# ==========================================
# THEN UN-IGNORE ONLY WHAT WE NEED
# ==========================================

# Keep this .gitignore itself
!.gitignore

# Keep .htaccess (cPanel routing)
!.htaccess

# Keep build folder and all its contents
!build/
!build/**

# ==========================================
# EXPLICITLY IGNORE HEAVY/SENSITIVE STUFF
# (safety — even though * covers them)
# ==========================================
node_modules/
src/
public/
.env
.env.local
.env.development
.env.development.local
.env.test.local
