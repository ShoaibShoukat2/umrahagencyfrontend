# Dependencies - ignore karo
/node_modules
/.pnp
.pnp.js

# Testing
/coverage

# Source code - ignore karo (sirf build chahiye)
/src
/public
/docs

# Config files - ignore karo
package.json
package-lock.json
README.md
vercel.json

# Env files - ignore karo
.env
.env.local
.env.development
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS
Thumbs.db
.DS_Store

# Build folder ka content push hoga (build/ is NOT ignored)
# .htaccess bhi push hoga (cPanel ke liye zaroori)
