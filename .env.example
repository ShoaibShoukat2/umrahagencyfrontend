# Backend API URL
# Production: Use your backend domain
# Development: Use /api (proxy will handle it)
REACT_APP_API_URL=https://samugatravels1.pythonanywhere.com/api

# Disable host check (required for cPanel deployment)
DANGEROUSLY_DISABLE_HOST_CHECK=true

# WebSocket port (for development)
WDS_SOCKET_PORT=0

# ==========================================
# INSTRUCTIONS:
# ==========================================
# 1. Copy this file to .env.local for development
# 2. Copy this file to .env.production for production
# 3. Update REACT_APP_API_URL with your actual backend URL
# 4. NEVER commit .env files to git
# ==========================================
